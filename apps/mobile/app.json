{
  "expo": {
    "name": "Dyno",
    "slug": "dyno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/Icon.png",
    "scheme": "dyno",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/adaptative-icon.png",
        "backgroundImage": "./src/assets/images/adaptative-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dyno.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/Icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4b277a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Dyno acesse suas fotos.",
          "cameraPermission": "Permita que o Dyno use a câmera para fotografar suas peças.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
